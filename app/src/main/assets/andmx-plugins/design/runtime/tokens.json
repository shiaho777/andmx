{
  "name": "andmx-design-tokens",
  "version": 2,
  "source": "com.andmx.ui2.theme (Type.kt / Motion.kt / Theme.kt / Chrome.kt)",
  "colors": {
    "brand": "#0EA5E9",
    "brandSoft": "#E0F2FE",
    "success": "#46BF72",
    "warning": "#FF8A30",
    "destructive": "#FF5C5C",
    "light": {
      "background": "#F8F8F8",
      "sidebar": "#F0F0F0",
      "winAlt": "#ECECEE",
      "foreground": "#262626",
      "surface": "#FFFFFF",
      "error": "#E03131"
    },
    "dark": {
      "background": "#161616",
      "header": "#202020",
      "card": "#2B2B2B",
      "secondary": "#363636",
      "foreground": "#D4D4D4",
      "error": "#FF5C5C"
    }
  },
  "type": {
    "chatBody": { "fontSizeSp": 15, "lineHeightSp": 22, "weight": "normal" },
    "chatBodyMuted": { "fontSizeSp": 13.5, "lineHeightSp": 20, "weight": "normal" },
    "cardTitle": { "fontSizeSp": 13, "lineHeightSp": 18, "weight": "medium" },
    "cardMeta": { "fontSizeSp": 12, "lineHeightSp": 16, "weight": "normal" },
    "micro": { "fontSizeSp": 11, "lineHeightSp": 14, "weight": "normal" },
    "code": { "fontSizeSp": 13, "lineHeightSp": 19, "weight": "normal" },
    "stat": { "fontSizeSp": 17, "lineHeightSp": 22, "weight": "semibold" },
    "statLarge": { "fontSizeSp": 18, "lineHeightSp": 24, "weight": "semibold" },
    "input": { "fontSizeSp": 14, "lineHeightSp": 20, "weight": "normal" }
  },
  "spacing": {
    "xsDp": 4,
    "smDp": 8,
    "mdDp": 12,
    "lgDp": 16,
    "xlDp": 24,
    "gutterDp": 16
  },
  "radius": {
    "xsDp": 2,
    "smDp": 8,
    "mdDp": 12,
    "bubbleDp": 20,
    "sheetDp": 20
  },
  "shadow": {
    "restDp": 1,
    "raisedDp": 6,
    "dragDp": 8
  },
  "motion": {
    "fastMs": 120,
    "baseMs": 160,
    "enterMs": 200,
    "inkMs": 320,
    "easingCubicBezier": [0.22, 0.61, 0.36, 1.0],
    "springDampingRatio": 0.82,
    "springStiffness": 380
  }
}